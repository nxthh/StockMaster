<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefWidth="1100" prefHeight="760"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.inventory.controller.POSController">

    <!-- ===================== TOP: title bar + search bar ===================== -->
    <top>
        <VBox styleClass="page-header" spacing="10">
            <padding>
                <Insets top="10" right="15" bottom="10" left="15"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Button styleClass="secondary" text="Back" onAction="#handleBack"/>
                <Label text="Point of Sale" styleClass="page-title"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Search:"/>
                <TextField fx:id="searchField" promptText="Search by ID or name" prefWidth="220"/>

                <Label text="Category:"/>
                <ComboBox fx:id="categoryFilterComboBox" prefWidth="130"/>

                <Button styleClass="secondary" text="Refresh" onAction="#handleRefreshProducts"/>
            </HBox>
        </VBox>
    </top>

    <!-- ===================== CENTER: product table (left) + cart (right) ===================== -->
    <center>
        <HBox spacing="15">
            <BorderPane.margin>
                <Insets top="0" right="15" bottom="15" left="15"/>
            </BorderPane.margin>

            <!-- ===== LEFT: product selection ===== -->
            <VBox spacing="10" HBox.hgrow="ALWAYS" prefWidth="560">
                <Label text="Products" styleClass="section-title"/>

                <TableView fx:id="productTable" VBox.vgrow="ALWAYS">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="idColumn" text="ID" prefWidth="70"/>
                        <TableColumn fx:id="nameColumn" text="Product" prefWidth="180"/>
                        <TableColumn fx:id="categoryColumn" text="Category" prefWidth="90"/>
                        <TableColumn fx:id="priceColumn" text="Price" prefWidth="80"/>
                        <TableColumn fx:id="stockColumn" text="Stock" prefWidth="80"/>
                    </columns>
                </TableView>

                <Label fx:id="selectedProductLabel" text="Selected: (none)" wrapText="true"/>

                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="Quantity:"/>
                    <TextField fx:id="quantityField" text="1" prefWidth="70"/>
                    <Button fx:id="addToCartButton" text="Add to Cart" onAction="#handleAddToCart"/>
                </HBox>
            </VBox>

            <!-- ===== RIGHT: cart + checkout ===== -->
            <ScrollPane fitToWidth="true" prefWidth="440" HBox.hgrow="NEVER">
            <VBox styleClass="panel" spacing="10" prefWidth="420">
                <padding>
                    <Insets top="16" right="16" bottom="16" left="16"/>
                </padding>

                <Label text="Cart" styleClass="section-title"/>

                <TableView fx:id="cartTable" prefHeight="220">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="cartProductColumn" text="Product" prefWidth="150"/>
                        <TableColumn fx:id="cartQuantityColumn" text="Quantity" prefWidth="70"/>
                        <TableColumn fx:id="cartPriceColumn" text="Price" prefWidth="80"/>
                        <TableColumn fx:id="cartSubtotalColumn" text="Subtotal" prefWidth="90"/>
                    </columns>
                </TableView>

                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="New Quantity:"/>
                    <TextField fx:id="updateQuantityField" prefWidth="70"/>
                    <Button fx:id="updateQuantityButton" text="Update Quantity" onAction="#handleUpdateQuantity"/>
                </HBox>

                <HBox spacing="8">
                    <Button styleClass="secondary" fx:id="removeItemButton" text="Remove Item" onAction="#handleRemoveItem"/>
                    <Button styleClass="secondary" fx:id="clearCartButton" text="Clear Cart" onAction="#handleClearCart"/>
                </HBox>

                <Separator/>

                <Label fx:id="subtotalLabel" text="Subtotal: $0.00" styleClass="summary-strong"/>

                <!-- ===== Checkout: discount / tax / total breakdown ===== -->
                <Label text="Checkout" styleClass="section-title"/>

                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="Discount (%):"/>
                    <TextField fx:id="discountField" text="0" prefWidth="70"/>
                </HBox>

                <Label fx:id="discountAmountLabel" text="Discount: $0.00"/>
                <Label fx:id="taxAmountLabel" text="Tax: $0.00"/>
                <Label fx:id="totalLabel" text="TOTAL: $0.00" styleClass="total-label"/>

                <Separator/>

                <!-- ===== Checkout: payment ===== -->
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="Payment:"/>
                    <ComboBox fx:id="paymentMethodComboBox" prefWidth="120"/>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="Amount Paid:"/>
                    <TextField fx:id="amountPaidField" prefWidth="90"/>
                </HBox>

                <Label fx:id="changeLabel" text="Change: $0.00" styleClass="section-title"/>

                <Button styleClass="success, large" fx:id="checkoutButton" text="CHECKOUT" onAction="#handleCheckout"
                         maxWidth="Infinity"/>

                <Separator/>

                <Label fx:id="statusMessageLabel" wrapText="true" styleClass="status-success"/>
            </VBox>
            </ScrollPane>
        </HBox>
    </center>

</BorderPane>
