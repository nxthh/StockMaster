<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefWidth="900" prefHeight="600"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.inventory.controller.DashboardController">

    <!-- ===================== TOP: application title bar =====================
         Just a title + who is currently logged in. All navigation now lives
         in the sidebar on the left instead of up here. -->
    <top>
        <HBox styleClass="app-titlebar" alignment="CENTER_LEFT" spacing="10">
            <padding>
                <Insets top="12" right="20" bottom="12" left="20"/>
            </padding>
            <Label text="Inventory &amp; POS" styleClass="app-title-label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="currentUserLabel" styleClass="app-user-label"/>
        </HBox>
    </top>

    <!-- ===================== LEFT: sidebar navigation =====================
         One button per screen. Every onAction handler already existed in
         DashboardController before this layout change - only WHERE the
         buttons are placed on screen changed, not what they do. -->
    <left>
        <VBox styleClass="sidebar" spacing="4" prefWidth="190">
            <padding>
                <Insets top="15" right="10" bottom="15" left="10"/>
            </padding>

            <Button text="Dashboard" styleClass="sidebar-button, sidebar-button-active"
                    maxWidth="Infinity" onAction="#handleRefreshDashboard"/>
            <Button text="POS" styleClass="sidebar-button"
                    maxWidth="Infinity" onAction="#handleOpenPOS"/>
            <Button fx:id="inventoryButton" text="Inventory" styleClass="sidebar-button"
                    maxWidth="Infinity" onAction="#handleOpenInventory">
                <tooltip>
                    <Tooltip text="Admin only"/>
                </tooltip>
            </Button>
            <Button text="Transactions" styleClass="sidebar-button"
                    maxWidth="Infinity" onAction="#handleOpenTransactions"/>
            <Button fx:id="reportsButton" text="Reports" styleClass="sidebar-button"
                    maxWidth="Infinity" onAction="#handleOpenReports">
                <tooltip>
                    <Tooltip text="Admin only"/>
                </tooltip>
            </Button>
            <Button fx:id="usersButton" text="Manage Users" styleClass="sidebar-button"
                    maxWidth="Infinity" onAction="#handleOpenUsers">
                <tooltip>
                    <Tooltip text="Admin only"/>
                </tooltip>
            </Button>

            <Region VBox.vgrow="ALWAYS"/>

            <Separator/>
            <Button text="Logout" styleClass="sidebar-button, sidebar-button-logout"
                    maxWidth="Infinity" onAction="#handleLogout"/>
        </VBox>
    </left>

    <!-- ===================== CENTER: main content =====================
         Summary cards (unchanged ids) + three charts. The content sits in a
         ScrollPane so nothing gets cut off on a small window.
         The charts are empty here; DashboardController fills them with data. -->
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER">
            <VBox alignment="TOP_LEFT" spacing="20">
                <padding>
                    <Insets top="24" right="28" bottom="24" left="28"/>
                </padding>

                <!-- Title row: page title on the left, Refresh on the right -->
                <HBox alignment="CENTER_LEFT">
                    <Label text="Dashboard" styleClass="page-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button styleClass="secondary" text="Refresh" onAction="#handleRefreshDashboard"/>
                </HBox>

                <!-- ===================== Summary cards =====================
                     hgrow + maxWidth let the five cards share the row evenly
                     instead of overflowing on narrow windows. -->
                <HBox alignment="CENTER_LEFT" spacing="16">

                    <VBox alignment="CENTER_LEFT" spacing="6" styleClass="stat-card" prefWidth="120" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                        <Label text="Total Products" styleClass="stat-caption"/>
                        <Label fx:id="totalProductsLabel" text="0" styleClass="stat-value"/>
                    </VBox>

                    <VBox alignment="CENTER_LEFT" spacing="6" styleClass="stat-card" prefWidth="120" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                        <Label text="Inventory Items" styleClass="stat-caption"/>
                        <Label fx:id="totalInventoryItemsLabel" text="0" styleClass="stat-value"/>
                    </VBox>

                    <VBox alignment="CENTER_LEFT" spacing="6" styleClass="stat-card, stat-card-danger" prefWidth="120" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                        <Label text="Low Stock" styleClass="stat-caption"/>
                        <Label fx:id="lowStockProductsLabel" text="0" styleClass="stat-value, stat-value-danger"/>
                    </VBox>

                    <VBox alignment="CENTER_LEFT" spacing="6" styleClass="stat-card" prefWidth="120" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                        <Label text="Transactions" styleClass="stat-caption"/>
                        <Label fx:id="totalTransactionsLabel" text="0" styleClass="stat-value"/>
                    </VBox>

                    <VBox alignment="CENTER_LEFT" spacing="6" styleClass="stat-card, stat-card-success" prefWidth="120" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                        <Label text="Total Revenue" styleClass="stat-caption"/>
                        <Label fx:id="totalRevenueLabel" text="0.00" styleClass="stat-value, stat-value-success"/>
                    </VBox>

                </HBox>

                <!-- ===================== Charts, row 1 =====================
                     Left: revenue per day (bar chart). Right: stock by category (pie). -->
                <HBox spacing="16">

                    <VBox styleClass="chart-card" spacing="8" prefWidth="400" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                        <Label text="Revenue - Last 7 Days" styleClass="section-title"/>
                        <BarChart fx:id="revenueBarChart" legendVisible="false" animated="false"
                                  prefHeight="260" minHeight="220" categoryGap="14">
                            <xAxis><CategoryAxis/></xAxis>
                            <yAxis><NumberAxis label="Revenue"/></yAxis>
                        </BarChart>
                    </VBox>

                    <VBox styleClass="chart-card" spacing="8" prefWidth="280" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                        <Label text="Stock by Category" styleClass="section-title"/>
                        <PieChart fx:id="categoryPieChart" animated="false" labelsVisible="false"
                                  legendVisible="true" prefHeight="260" minHeight="220"/>
                    </VBox>

                </HBox>

                <!-- ===================== Charts, row 2 =====================
                     Products with the lowest stock. -->
                <VBox styleClass="chart-card" spacing="8">
                    <Label text="Lowest Stock Products" styleClass="section-title"/>
                    <BarChart fx:id="lowStockBarChart" legendVisible="false" animated="false"
                              prefHeight="260" minHeight="220" categoryGap="14">
                        <xAxis><CategoryAxis/></xAxis>
                        <yAxis><NumberAxis label="Quantity"/></yAxis>
                    </BarChart>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
