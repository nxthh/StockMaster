<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefWidth="900" prefHeight="600"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.inventory.controller.DashboardController">

    <!-- ===================== TOP: application title bar =====================
         Just a title + who is currently logged in. All navigation now lives
         in the sidebar on the left instead of up here. -->
    <top>
        <HBox styleClass="app-titlebar" alignment="CENTER_LEFT" spacing="10">
            <padding>
                <Insets top="12" right="20" bottom="12" left="20"/>
            </padding>
            <Label text="APPLICATION" styleClass="app-title-label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="currentUserLabel" styleClass="app-user-label"/>
        </HBox>
    </top>

    <!-- ===================== LEFT: sidebar navigation =====================
         One button per screen. Every onAction handler already existed in
         DashboardController before this layout change - only WHERE the
         buttons are placed on screen changed, not what they do. -->
    <left>
        <VBox styleClass="sidebar" spacing="4" prefWidth="190">
            <padding>
                <Insets top="15" right="10" bottom="15" left="10"/>
            </padding>

            <Button text="Dashboard" styleClass="sidebar-button, sidebar-button-active"
                    maxWidth="Infinity" onAction="#handleRefreshDashboard"/>
            <Button text="POS" styleClass="sidebar-button"
                    maxWidth="Infinity" onAction="#handleOpenPOS"/>
            <Button fx:id="inventoryButton" text="Inventory" styleClass="sidebar-button"
                    maxWidth="Infinity" onAction="#handleOpenInventory">
                <tooltip>
                    <Tooltip text="Admin only"/>
                </tooltip>
            </Button>
            <Button text="Transactions" styleClass="sidebar-button"
                    maxWidth="Infinity" onAction="#handleOpenTransactions"/>
            <Button fx:id="reportsButton" text="Reports" styleClass="sidebar-button"
                    maxWidth="Infinity" onAction="#handleOpenReports">
                <tooltip>
                    <Tooltip text="Admin only"/>
                </tooltip>
            </Button>
            <Button fx:id="usersButton" text="Manage Users" styleClass="sidebar-button"
                    maxWidth="Infinity" onAction="#handleOpenUsers">
                <tooltip>
                    <Tooltip text="Admin only"/>
                </tooltip>
            </Button>

            <Region VBox.vgrow="ALWAYS"/>

            <Separator/>
            <Button text="Logout" styleClass="sidebar-button, sidebar-button-logout"
                    maxWidth="Infinity" onAction="#handleLogout"/>
        </VBox>
    </left>

    <!-- ===================== CENTER: main content =====================
         Unchanged from before - the summary cards and Refresh button just
         moved from being the whole screen's content under a top bar of
         buttons, to being the "Main Content" area next to the sidebar. -->
    <center>
        <VBox alignment="CENTER" spacing="20">
            <padding>
                <Insets top="10" right="15" bottom="15" left="15"/>
            </padding>

            <Label text="Dashboard" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

            <!-- ===================== Summary cards ===================== -->
            <HBox alignment="CENTER" spacing="15">

                <VBox alignment="CENTER" spacing="4" style="-fx-background-color: #f4f4f4; -fx-background-radius: 8; -fx-padding: 15;" prefWidth="130">
                    <Label text="Total Products" style="-fx-font-size: 11px; -fx-text-fill: #555;"/>
                    <Label fx:id="totalProductsLabel" text="0" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
                </VBox>

                <VBox alignment="CENTER" spacing="4" style="-fx-background-color: #f4f4f4; -fx-background-radius: 8; -fx-padding: 15;" prefWidth="130">
                    <Label text="Inventory Items" style="-fx-font-size: 11px; -fx-text-fill: #555;"/>
                    <Label fx:id="totalInventoryItemsLabel" text="0" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
                </VBox>

                <VBox alignment="CENTER" spacing="4" style="-fx-background-color: #fdecea; -fx-background-radius: 8; -fx-padding: 15;" prefWidth="130">
                    <Label text="Low Stock" style="-fx-font-size: 11px; -fx-text-fill: #555;"/>
                    <Label fx:id="lowStockProductsLabel" text="0" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #c62828;"/>
                </VBox>

                <VBox alignment="CENTER" spacing="4" style="-fx-background-color: #f4f4f4; -fx-background-radius: 8; -fx-padding: 15;" prefWidth="130">
                    <Label text="Transactions" style="-fx-font-size: 11px; -fx-text-fill: #555;"/>
                    <Label fx:id="totalTransactionsLabel" text="0" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
                </VBox>

                <VBox alignment="CENTER" spacing="4" style="-fx-background-color: #e8f5e9; -fx-background-radius: 8; -fx-padding: 15;" prefWidth="130">
                    <Label text="Total Revenue" style="-fx-font-size: 11px; -fx-text-fill: #555;"/>
                    <Label fx:id="totalRevenueLabel" text="0.00" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2e7d32;"/>
                </VBox>

            </HBox>

            <Button text="Refresh" onAction="#handleRefreshDashboard"/>
        </VBox>
    </center>

</BorderPane>
