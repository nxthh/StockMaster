<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefWidth="820" prefHeight="560"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.inventory.controller.UserController">

    <!-- ===================== TOP: title bar ===================== -->
    <top>
        <VBox spacing="10">
            <padding>
                <Insets top="10" right="15" bottom="10" left="15"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Button text="Back" onAction="#handleBack"/>
                <Label text="Manage Users" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            </HBox>

            <Label fx:id="roleLabel" text="Logged in as: "/>
        </VBox>
    </top>

    <!-- ===================== CENTER: existing accounts ===================== -->
    <center>
        <VBox spacing="10">
            <BorderPane.margin>
                <Insets top="0" right="15" bottom="15" left="15"/>
            </BorderPane.margin>

            <Label text="Existing Accounts" style="-fx-font-weight: bold;"/>

            <TableView fx:id="usersTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="usernameColumn" text="Username" prefWidth="200"/>
                    <TableColumn fx:id="roleColumn" text="Role" prefWidth="120"/>
                </columns>
            </TableView>

            <Button text="Refresh" onAction="#handleRefresh"/>
        </VBox>
    </center>

    <!-- ===================== RIGHT: create a new cashier account ===================== -->
    <right>
        <VBox spacing="12" prefWidth="280">
            <padding>
                <Insets top="15" right="15" bottom="15" left="0"/>
            </padding>

            <Label text="Create Cashier Account" style="-fx-font-weight: bold;"/>
            <Label text="Only Cashier accounts can be created here. Admin accounts are managed directly in data/users.txt."
                   wrapText="true" style="-fx-font-size: 11px; -fx-text-fill: #607d8b;"/>

            <GridPane hgap="8" vgap="8">
                <columnConstraints>
                    <ColumnConstraints minWidth="110"/>
                    <ColumnConstraints minWidth="150"/>
                </columnConstraints>

                <Label text="Username" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="newUsernameField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Password" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <PasswordField fx:id="newPasswordField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Confirm Password" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <PasswordField fx:id="confirmPasswordField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            </GridPane>

            <Button fx:id="createCashierButton" text="Create Cashier Account"
                    onAction="#handleCreateCashier" maxWidth="Infinity"/>

            <Separator/>

            <Label fx:id="statusMessageLabel" wrapText="true" style="-fx-text-fill: #2e7d32;"/>
        </VBox>
    </right>

</BorderPane>
